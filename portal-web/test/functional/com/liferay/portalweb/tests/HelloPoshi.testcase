@component-name = "app-builder"
definition {
    property testray.main.component.name = "App Builder";

    setUp {
        TestCase.setUpPortalInstance();

        User.firstLoginPG();

        Navigator.openURL();
    }

    // tearDown {
    //     User.logoutAndLoginPG(
    //         userLoginEmailAddress = "test@liferay.com",
    //         userLoginFullName = "Test Test");
    // }

    @description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel"
    @priority = "5"
    test ValidateConfigurationStringAtControlPanel {
        
        ApplicationsMenuHelper.openApplicationsMenu();
        ApplicationsMenu.gotoPanel(panel = "Control Panel");
        AssertTextEquals(
			locator1 = "Panel#CONTROL_PANEL_CONFIGURATION",
			value1 = "Configuration");

    }

    @description = "Set Screen size to custom and validate values"
    @priority = "5"
    test SetScreenSizeAndValidateValues {


        MobileDevice.previewPG(
			deviceType = "custom",
			height = "1920",
			width = "1080");

        Pause(locator1 = "3000");

        ControlMenu.openSimulation();   
        ControlMenu.openSimulation();   


        AssertTextEquals(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD",
			value1 = "1920");

        AssertTextEquals(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD",
			value1 = "1080");


    }

    test FantasticTest{

        ProductMenu.gotoPortlet(
            category = "Content & Data",
            portlet = "Web Content"
        );

        NavItem.gotoStructures();

        WebContentStructures.addCP(structureName = "Anything");
        DataEngine.addFields(fieldNameList = "Numeric,Text");
        Button.clickSave();       
    

        WebContentStructures.editStructureDefaultValuesCP(structureName = "Anything");

        Button.clickSave();

        Alert.viewSuccessMessage();

        WebContentStructures.deleteCP(structureName = "Anything");

        Alert.viewSuccessMessage();       


    }

