@component-name = "portal-wcm"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Web Content Administration";

	setUp {
		 TestCase.setUpPortalInstance();
        User.firstLoginPG();
        Navigator.openURL();
     
        
      	ProductMenu.gotoPortlet(
		category = "Content & Data",
		portlet = "Web Content"); 

        AppBuilderAdmin.switchTab(tabName = "Structures");  

        WebContentStructures.addCP(
		structureName = "Test");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		WebContentStructures.deleteCP(
			structureName = "Test"
		);

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONGroup.deleteGroupByName(groupName = "Test Site Name");
		}
	}

	@description = "This is a test for LPS-98081. As a Developer, I want to use separators"
	@ignore = "true"
	@priority = "5"
	test AddSeparatorOnFormByDragAndDrop {
		property portal.acceptance = "false";

		// TODO LPS-98081 AddSeparatorOnFormByDragAndDrop pending implementation

